#!/bin/sh

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
. /lib/functions.sh
umask 077
RUN=/var/run/mf832s
LOCK=/var/run/mf832s.lock
STATUS_FILE=/var/run/mf832s/status
child=
owned_device=
owned_usb=
owned_generation=
generation=
next_try=0
lease_deadline=0
interrupted=0
transaction_active=0
health_next=0
health_bad=0
recover_bad=0
recover_next=0
owned_online=0
owned_event=
attempt_event=
transaction_mode=
diagnostic=
config_error=
target_device=
discovery_reason=
validation_reason=
at_failure=unknown-response
stage=starting
stage_reason='monitor starting'
stage_started=0
stage_updated=0
state_health=unknown
has_ipv4=false
observed_ipv4=false
event_reader=
event_listener=
event_guard=
event_epoch=0
fence=0
auto_at=
auto_generation=

log() { logger -t mf832s "$*"; }
notice() {
	[ "$diagnostic" = "$1" ] || log "$1"
	diagnostic=$1
}
now() { date +%s; }
write_state() {
	local tmp
	[ -d "${STATUS_FILE%/*}" ] || return 1
	tmp="${STATUS_FILE}.$$"
	{
		printf 'service=%s\n' "${state_service:-running}"
		printf 'pid=%s\n' "${monitor_pid-}"
		printf 'instance=%s\n' "${RUN:-}"
		printf 'target=%s\n' "${interface:-}"
		printf 'configured_net=%s\n' "${net_device:-}"
		printf 'target_device=%s\n' "${target_device:-}"
		printf 'usb=%s\n' "${usb:-}"
		printf 'at=%s\n' "${at:-}"
		printf 'net=%s\n' "${net:-}"
		printf 'stage=%s\n' "$stage"
		printf 'reason=%s\n' "$stage_reason"
		printf 'stage_started=%s\n' "$stage_started"
		printf 'updated=%s\n' "$stage_updated"
		printf 'retry_at=%s\n' "$next_try"
		printf 'lease_deadline=%s\n' "$lease_deadline"
		printf 'has_ipv4=%s\n' "$has_ipv4"
		printf 'health=%s\n' "$state_health"
	} >"$tmp" || { rm -f "$tmp"; return 1; }
	chmod 600 "$tmp" && mv -f "$tmp" "$STATUS_FILE"
}
set_stage() {
	local changed old_stage
	changed=0
	if [ "$stage" != "$1" ] || [ "$stage_reason" != "$2" ]; then
		changed=1
		old_stage=$stage
		stage=$1
		stage_reason=$2
		stage_updated=$(now)
		if [ "$old_stage" != "$stage" ] || [ "$stage_started" -eq 0 ]; then
			stage_started=$stage_updated
		fi
		write_state
		[ "${3:-}" = quiet ] || log "stage=$stage: $stage_reason"
	elif [ "$stage_updated" -eq 0 ]; then
		stage_updated=$(now)
		stage_started=$stage_updated
		write_state
	fi
}
stage_failure() {
	set_stage "$1" "$2" quiet
	notice "stage=$1: $2"
}
cancel() {
	interrupted=1
	[ -z "$child" ] || kill "$child" 2>/dev/null
}

wake() {
	if [ "$transaction_active" = 1 ]; then
		# Duplicate/unrelated events must not starve a valid modem transaction.
		transaction_valid && return
		cancel
	elif [ -n "$child" ]; then
		cancel
	fi
}

valid_name() {
	case "$1" in ''|*[!a-zA-Z0-9_.-]*) return 1;; esac
	[ "${#1}" -le 64 ]
}

number() {
	case "$2" in ''|*[!0-9]*) return 1;; esac
	case "$2" in 0[0-9]*) return 1;; esac
	[ "${#2}" -le 5 ] && [ "$2" -ge "$3" ] && [ "$2" -le "$4" ] ||
		return 1
}

load_config() {
	config_error=
	config_load mf832s
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || { config_error=disabled; return 1; }
	config_get interface main interface mf832s
	config_get apn main apn ''
	config_get pdp_type main pdp_type IPV4V6
	config_get cid main cid 1
	config_get vid main vid 19d2
	config_get pid main pid 0199
	config_get usb_path main usb_path ''
	config_get serial main serial ''
	config_get at_interface main at_interface ''
	config_get at_device main at_device ''
	config_get net_device main net_device ''
	config_get query_timeout main query_timeout 5
	config_get transaction_timeout main transaction_timeout 45
	config_get poll_interval main poll_interval 10
	config_get retry_initial main retry_initial 5
	config_get retry_max main retry_max 120
	config_get dhcp_timeout main dhcp_timeout 60
	config_get health_interval main health_interval 30
	config_get health_failures main health_failures 3
	config_get recover_mode main recover_mode cfun_cycle
	config_get recover_threshold main recover_threshold 3
	config_get recover_cooldown main recover_cooldown 120
	valid_name "$interface" || { config_error=invalid-target-interface; return 1; }
	# APNs cannot inject chat syntax or AT commands; the empty default is allowed.
	case "$apn" in *[!a-zA-Z0-9._-]*) config_error=invalid-apn-format; return 1;; esac
	[ "${#apn}" -le 100 ] || { config_error=invalid-apn-length; return 1; }
	case "$pdp_type" in IP|IPV6|IPV4V6) :;; *) config_error=invalid-pdp-type; return 1;; esac
	case "$recover_mode" in none|cfun_cycle) :;; *) config_error=invalid-recovery-mode; return 1;; esac
	number cid "$cid" 1 16 || { config_error=invalid-cid; return 1; }
	number query_timeout "$query_timeout" 1 30 || { config_error=invalid-query-timeout; return 1; }
	number transaction_timeout "$transaction_timeout" 5 300 || { config_error=invalid-transaction-timeout; return 1; }
	number poll_interval "$poll_interval" 1 300 || { config_error=invalid-poll-interval; return 1; }
	number retry_initial "$retry_initial" 1 300 || { config_error=invalid-initial-retry; return 1; }
	number retry_max "$retry_max" "$retry_initial" 3600 || { config_error=invalid-maximum-retry; return 1; }
	number dhcp_timeout "$dhcp_timeout" 5 600 || { config_error=invalid-dhcp-timeout; return 1; }
	number health_interval "$health_interval" 5 600 || { config_error=invalid-health-interval; return 1; }
	number health_failures "$health_failures" 1 10 || { config_error=invalid-health-failure-limit; return 1; }
	number recover_threshold "$recover_threshold" 1 100 || { config_error=invalid-recovery-threshold; return 1; }
	number recover_cooldown "$recover_cooldown" 0 86400 || { config_error=invalid-recovery-cooldown; return 1; }
	[ "$transaction_timeout" -ge "$query_timeout" ] || { config_error=transaction-timeout-before-query-timeout; return 1; }
	case "$vid$pid" in *[!0-9a-fA-F]*) config_error=invalid-usb-vid-pid; return 1;; esac
	[ "${#vid}" = 4 ] && [ "${#pid}" = 4 ] || { config_error=invalid-usb-vid-pid; return 1; }
	vid=$(printf '%s' "$vid" | tr A-F a-f)
	pid=$(printf '%s' "$pid" | tr A-F a-f)
	case "$usb_path" in *[!0-9.-]*) config_error=invalid-usb-path; return 1;; esac
	if [ -n "$at_interface" ]; then
		case "$at_interface" in *[!0-9a-fA-F]*) config_error=invalid-at-interface; return 1;; esac
		[ "${#at_interface}" = 2 ] || { config_error=invalid-at-interface; return 1; }
		at_interface=$(printf '%s' "$at_interface" | tr A-F a-f)
	fi
	if [ -n "$at_device" ]; then
		case "$at_device" in /dev/ttyUSB*) suffix=${at_device#/dev/ttyUSB};;
			/dev/ttyACM*) suffix=${at_device#/dev/ttyACM};; *) config_error=invalid-at-device; return 1;; esac
		case "$suffix" in ''|*[!0-9]*) config_error=invalid-at-device; return 1;; esac
	fi
	[ -z "$net_device" ] || valid_name "$net_device" || { config_error=invalid-network-device; return 1; }
	backoff=$retry_initial
	config_error=
}

usb_parent() {
	local path
	path=$(readlink -f "$1") || return 1
	while [ -n "$path" ] && [ "$path" != / ]; do
		if [ -f "$path/idVendor" ] && [ -f "$path/idProduct" ]; then
			printf '%s\n' "$path"
			return 0
		fi
		path=${path%/*}
	done
	return 1
}

stamp() {
	[ -r "$1/busnum" ] && [ -r "$1/devnum" ] || return 1
	printf '%s:%s:%s\n' "$1" "$(cat "$1/busnum")" "$(cat "$1/devnum")"
}

discover() {
	local path count candidate parent tty_path walk ifnum
	usb='' at='' net=''
	at_candidates=
	count=0
	for path in /sys/bus/usb/devices/*; do
		[ -r "$path/idVendor" ] && [ -r "$path/idProduct" ] || continue
		[ "$(cat "$path/idVendor")" = "$vid" ] &&
		[ "$(cat "$path/idProduct")" = "$pid" ] || continue
		[ -z "$usb_path" ] || [ "${path##*/}" = "$usb_path" ] || continue
		[ -z "$serial" ] || [ "$(cat "$path/serial" 2>/dev/null)" = "$serial" ] || continue
		count=$((count + 1))
		usb=$(readlink -f "$path")
	done
	[ "$count" -gt 0 ] || { discovery_reason=usb-vid-pid-not-found; return 1; }
	[ "$count" = 1 ] || { discovery_reason=multiple-matching-usb-modems; return 1; }
	found_generation=$(stamp "$usb") || { discovery_reason=usb-device-not-ready; return 1; }
	count=0
	for tty_path in /sys/class/tty/ttyUSB* /sys/class/tty/ttyACM*; do
		[ -e "$tty_path/device" ] || continue
		candidate=/dev/${tty_path##*/}
		[ -z "$at_device" ] || [ "$candidate" = "$at_device" ] || continue
		parent=$(usb_parent "$tty_path/device") || continue
		[ "$parent" = "$usb" ] || continue
		walk=$(readlink -f "$tty_path/device")
		ifnum=ff
		while [ "$walk" != "$usb" ] && [ -n "$walk" ]; do
			if [ -r "$walk/bInterfaceNumber" ]; then
				ifnum=$(cat "$walk/bInterfaceNumber" | tr A-F a-f)
				break
			fi
			walk=${walk%/*}
		done
		[ -z "$at_interface" ] || [ "$ifnum" = "$at_interface" ] || continue
		[ -c "$candidate" ] || continue
		count=$((count + 1))
		at=$candidate
		at_candidates="${at_candidates}${ifnum} ${candidate}
"
	done
	if [ -n "$at_interface$at_device" ]; then
		[ "$count" -gt 0 ] || { discovery_reason=selected-at-port-not-ready; return 1; }
		[ "$count" = 1 ] || { discovery_reason=multiple-matching-at-ports; return 1; }
	else
		at=
		at_candidates=$(printf '%s' "$at_candidates" | sort -k1,1 -k2,2)
	fi
	count=0
	for path in /sys/class/net/*; do
		candidate=${path##*/}
		[ -z "$net_device" ] || [ "$candidate" = "$net_device" ] || continue
		parent=$(usb_parent "$path/device") || continue
		[ "$parent" = "$usb" ] || continue
		count=$((count + 1))
		net=$candidate
	done
	[ "$count" -gt 0 ] || { discovery_reason=usb-network-device-not-ready; return 1; }
	[ "$count" = 1 ] || { discovery_reason=multiple-matching-usb-network-devices; return 1; }
	discovery_reason=discovered
}

network_config() {
	local proto device section_type managed selected
	config_load mf832s
	config_get_bool managed main enabled 0
	config_get selected main interface mf832s
	[ "$managed" = 1 ] || { validation_reason=service-disabled; return 1; }
	[ "$selected" = "$interface" ] || { validation_reason=service-target-mismatch; return 1; }
	config_load network
	config_get section_type "$interface" TYPE
	config_get proto "$interface" proto
	config_get device "$interface" device
	target_device=$device
	[ "$section_type" = interface ] || { validation_reason=target-interface-missing; return 1; }
	[ "$proto" = dhcp ] || { validation_reason=target-protocol-not-dhcp; return 1; }
	[ "$device" = "$1" ] || { validation_reason=target-device-not-discovered-usb-net; return 1; }
	validation_reason=valid
}

network_status() {
	status=$(ubus -t 2 call "network.interface.$interface" status 2>/dev/null) ||
		{ validation_reason=network-status-unavailable; return 1; }
	up=$(jsonfilter -s "$status" -e '@.up')
	pending=$(jsonfilter -s "$status" -e '@.pending')
	available=$(jsonfilter -s "$status" -e '@.available')
	l3=$(jsonfilter -s "$status" -e '@.l3_device')
	status_device=$(jsonfilter -s "$status" -e '@.device')
	ipv4=$(jsonfilter -s "$status" -e '@["ipv4-address"][0].address')
	has_ipv4=false
	printf '%s\n' "$ipv4" | awk -F. '
		NF==4 {
			for (i=1;i<=4;i++) {
				if ($i !~ /^[0-9]+$/ || length($i)>3 || $i>255) exit 1
			}
			valid=1
		}
		END { exit !valid }
	' && has_ipv4=true
	[ "$up" = true ] || [ "$up" = false ] || { validation_reason=invalid-netifd-status; return 1; }
	[ "$pending" = true ] || [ "$pending" = false ] || { validation_reason=invalid-netifd-status; return 1; }
	[ "$available" = true ] || [ "$available" = false ] || { validation_reason=invalid-netifd-status; return 1; }
	[ -z "$l3" ] || [ "$l3" = "$1" ] || { validation_reason=netifd-l3-device-mismatch; return 1; }
	[ -z "$status_device" ] || [ "$status_device" = "$1" ] || { validation_reason=netifd-device-mismatch; return 1; }
	validation_reason=valid
}

network_down() {
	local parent
	[ -n "$owned_device" ] || return 0
	# Never bring down an interface whose configuration or physical owner changed.
	if network_config "$owned_device" && network_status "$owned_device"; then
		parent=$(usb_parent "/sys/class/net/$owned_device/device")
		if [ -z "$parent" ] || {
			[ "$parent" = "$owned_usb" ] &&
			[ "$(stamp "$parent" 2>/dev/null)" = "$owned_generation" ]
		}; then
			ubus -t 2 call "network.interface.$interface" down >/dev/null 2>&1 || return 1
		fi
	fi
	owned_device='' owned_usb='' owned_generation='' lease_deadline=0 owned_online=0 owned_event=''
}

coordinate_pending() {
	# Do not claim ownership before teardown: the target may have become online.
	same_generation && network_config "$net" && network_status "$net" &&
		[ "$up" = false ] && [ "$pending" = true ] || return 1
	ubus -t 2 call "network.interface.$interface" down >/dev/null 2>&1
}

cleanup() {
	state_service=stopped
	monitor_pid=
	stage=stopped
	stage_reason='monitor stopped by init service'
	stage_updated=$(now)
	write_state
	trap '' USR1
	cancel
	[ -z "$child" ] || kill -KILL "$child" 2>/dev/null
	[ -z "$child" ] || wait "$child" 2>/dev/null
	stop_events
	network_down
	# The persistent lock is outside this private directory and is never unlinked.
	rm -rf "$RUN"
}

same_generation() {
	[ "$(stamp "$usb" 2>/dev/null)" = "$generation" ] &&
	[ "$(usb_parent "/sys/class/tty/${at##*/}/device")" = "$usb" ] &&
	[ "$(usb_parent "/sys/class/net/$net/device")" = "$usb" ]
}

interface_event() {
	printf '%s:%s\n' "$event_epoch" "$(cat "$RUN/iface-sequence" 2>/dev/null)"
}

read_events() {
	local line target action sequence token
	sequence=0
	while IFS= read -r line; do
		target=$(jsonfilter -s "$line" -e '@["network.interface"].interface' 2>/dev/null)
		action=$(jsonfilter -s "$line" -e '@["network.interface"].action' 2>/dev/null)
		if [ "$target" = "$interface" ] && [ "$action" = ifdown ]; then
			sequence=$((sequence + 1))
			printf '%s\n' "$sequence" >"$RUN/iface-sequence.new" || return 1
			mv "$RUN/iface-sequence.new" "$RUN/iface-sequence" || return 1
			kill -USR1 "$monitor_pid" 2>/dev/null
		fi
		token=$(jsonfilter -s "$line" -e '@["mf832s.fence"].token' 2>/dev/null)
		case "$token" in ''|*[!0-9]*) continue;; esac
		printf '%s\n' "$token" >"$RUN/fence" || return 1
	done
}

stop_events() {
	[ -z "$event_guard" ] || kill "$event_guard" 2>/dev/null
	[ -z "$event_guard" ] || wait "$event_guard" 2>/dev/null
	exec 7>&-
	[ -z "$event_listener" ] || kill "$event_listener" 2>/dev/null
	[ -z "$event_reader" ] || kill "$event_reader" 2>/dev/null
	[ -z "$event_listener" ] || wait "$event_listener" 2>/dev/null
	[ -z "$event_reader" ] || wait "$event_reader" 2>/dev/null
	event_listener='' event_reader='' event_guard=''
}

event_barrier() {
	local end
	fence=$((fence + 1))
	end=$(( $(now) + 5 ))
	while [ "$(now)" -lt "$end" ]; do
		kill -0 "$event_listener" 2>/dev/null &&
			kill -0 "$event_reader" 2>/dev/null &&
			kill -0 "$event_guard" 2>/dev/null || return 1
		ubus -t 1 send mf832s.fence "{\"token\":$fence}" >/dev/null 2>&1 || return 1
		[ "$(cat "$RUN/fence" 2>/dev/null)" = "$fence" ] && return 0
		sleep 1
	done
	return 1
}

ensure_events() {
	if [ -n "$event_listener" ] && [ -n "$event_reader" ] && [ -n "$event_guard" ] &&
		kill -0 "$event_listener" 2>/dev/null && kill -0 "$event_reader" 2>/dev/null &&
		kill -0 "$event_guard" 2>/dev/null; then
		return 0
	fi
	stop_events
	event_epoch=$((event_epoch + 1))
	rm -f "$RUN/events" "$RUN/fence" "$RUN/lifetime"
	mkfifo "$RUN/events" "$RUN/lifetime" || return 1
	exec 7<>"$RUN/lifetime" || return 1
	printf '0\n' >"$RUN/iface-sequence"
	( exec 9>&- 7>&-; read_events <"$RUN/events" ) &
	event_reader=$!
	( exec 9>&- 7>&-; exec ubus -S listen network.interface mf832s.fence >"$RUN/events" 2>/dev/null ) &
	event_listener=$!
	# Open the read end before forking: a crash must not leave the guard in open().
	exec 6<"$RUN/lifetime" || return 1
	(
		exec 9>&- 7>&-
		# EOF also arrives on SIGKILL/crash, when normal cleanup cannot run.
		while IFS= read -r line; do :; done <&6
		kill "$event_listener" "$event_reader" 2>/dev/null
		rm -rf "$RUN"
	) &
	event_guard=$!
	exec 6<&-
	event_barrier
}

transaction_valid() {
	kill -0 "$event_listener" 2>/dev/null &&
		kill -0 "$event_reader" 2>/dev/null &&
		kill -0 "$event_guard" 2>/dev/null || return 1
	same_generation && network_config "$net" && network_status "$net" || return 1
	[ "$(interface_event)" = "$attempt_event" ] || return 1
	case "$transaction_mode" in
		probe) return 0;;
		activate|recover) [ "$up" = false ] && [ "$pending" = false ];;
		health) [ "$up" = true ];;
		*) return 1;;
	esac
}

await_child() {
	local end rc
	end=$1
	while kill -0 "$child" 2>/dev/null; do
		if [ "$interrupted" = 1 ] || [ "$(now)" -ge "$end" ] || ! transaction_valid; then
			kill -KILL "$child" 2>/dev/null
			wait "$child" 2>/dev/null
			child=
			return 1
		fi
		sleep 1
	done
	wait "$child"
	rc=$?
	child=
	[ "$rc" = 0 ] && [ "$interrupted" = 0 ] && transaction_valid
}

query() {
	local command timeout end
	command=$1
	# Discovery must never reach state-changing activation/recovery commands.
	[ "$transaction_mode" != probe ] || [ "$command" = AT ] ||
		{ at_failure=unsafe-probe-command; return 1; }
	at_failure=no-response-or-unsupported-command
	end=$(( $(now) + query_timeout ))
	[ "$end" -le "$transaction_end" ] || end=$transaction_end
	timeout=$((end - $(now)))
	[ "$timeout" -gt 0 ] || { at_failure=timeout; return 1; }
	[ "$interrupted" = 0 ] && transaction_valid || { at_failure=cancelled-or-device-changed; return 1; }
	{
		printf 'ABORT "\\r\\nERROR\\r\\n"\nABORT "+CME ERROR:"\nABORT "\\r\\nNO CARRIER\\r\\n"\nABORT "\\r\\nBUSY\\r\\n"\nTIMEOUT %s\n' "$timeout"
		printf "'' '%s'\n'\\\\r\\\\nOK\\\\r\\\\n' " "$command"
		if [ "$transaction_mode" = probe ]; then
			printf "'\\\\c'\n"
		else
			printf "''\n"
		fi
	} >"$RUN/query.chat"
	# Transcript is private and never passed to logger (it may contain an APN).
	(
		exec 9>&- 7>&-
		exec chat -S -s -V -f "$RUN/query.chat" <"$at" >"$at" 2>"$RUN/response"
	) &
	child=$!
	await_child "$end" && { at_failure=none; return 0; }
	if [ "$interrupted" = 1 ]; then
		at_failure=cancelled-or-device-changed
	elif [ "$(now)" -ge "$end" ]; then
		at_failure=timeout
	elif grep -E '(^|[[:space:]])(CME )?ERROR([[:space:]]|$)' "$RUN/response" >/dev/null 2>&1; then
		at_failure=AT-rejected
	elif [ ! -c "$at" ]; then
		at_failure=serial-unavailable
	else
		at_failure=no-response-or-unsupported-command
	fi
	return 1
}

registered() {
	local kind
	for kind in CEREG CGREG CREG; do
		if query "AT+$kind?"; then
			# Query replies are <n>,<stat>; one-field replies are <stat>.
			awk -v prefix="+$kind:" '
				index($0, prefix) {
					line=substr($0,index($0,prefix)+length(prefix))
					gsub(/\r/,"",line); gsub(/ /,"",line)
					n=split(line,a,","); s=(n>1 ? a[2] : a[1])
					if (s=="1" || s=="5") found=1
				}
				END { exit !found }
			' "$RUN/response" && return 0
		fi
		[ "$interrupted" = 0 ] || return 1
	done
	[ "$at_failure" != none ] || at_failure=not-registered-or-unsupported-response
	return 1
}

active() {
	local rc
	query "AT+$1?" || return 2
	awk -v prefix="+$1:" -v cid="$cid" '
		index($0,prefix) {
			line=substr($0,index($0,prefix)+length(prefix))
			gsub(/\r/,"",line); gsub(/ /,"",line)
			n=split(line,a,",")
			if (n!=2 || a[1]!~/^[0-9]+$/ || (a[2]!="0" && a[2]!="1"))
				malformed=1
			if (n==2 && a[1]==cid && (a[2]=="0" || a[2]=="1")) {
				known=1; if (a[2]=="1") found=1
			}
		}
		END { exit (found ? 0 : (known ? 1 : (malformed ? 2 : 3))) }
	' "$RUN/response"
	rc=$?
	case "$rc" in
		2) at_failure=unrecognized-PDP-state;;
		3) at_failure=PDP-state-not-reported;;
	esac
	return "$rc"
}

undefined_context() {
	query 'AT+CGDCONT?' || return 1
	awk -v cid="$cid" '
		index($0,"+CGDCONT:") {
			line=substr($0,index($0,"+CGDCONT:")+9)
			gsub(/\r/,"",line); gsub(/ /,"",line)
			n=split(line,a,",")
			if (a[1]==cid) defined=1
			if (n<3 || a[1]!~/^[0-9]+$/ ||
			    a[2]!~/^"[A-Za-z0-9]+"$/ || a[3]!~/^"[^"]*"$/)
				malformed=1
		}
		END { exit (defined || malformed) }
	' "$RUN/response" || {
		[ "$at_failure" != none ] || at_failure=unrecognized-PDP-context
		return 1
	}
}

configure_serial() {
	local end
	at_failure=serial-unavailable-or-cancelled
	[ "$interrupted" = 0 ] && transaction_valid || return 1
	end=$(( $(now) + query_timeout ))
	[ "$end" -le "$transaction_end" ] || end=$transaction_end
	[ "$end" -gt "$(now)" ] || { at_failure=timeout; return 1; }
	(
		exec 9>&- 7>&-
		# Do not drop DTR on close or enable hardware flow-control during probing.
		exec stty -F "$at" 115200 raw -echo clocal -hupcl -crtscts 2>/dev/null
	) &
	child=$!
	await_child "$end"
}

select_at() {
	local cache cached_generation cached_at candidate ifnum count rc
	[ -z "$at_interface$at_device" ] || return 0
	cache="${STATUS_FILE%/*}/at-port"
	cached_generation=$auto_generation
	cached_at=$auto_at
	if [ "$cached_generation" != "$generation" ]; then
		cached_generation=$(sed -n '1p' "$cache" 2>/dev/null)
		cached_at=$(sed -n '2p' "$cache" 2>/dev/null)
	fi
	if [ "$cached_generation" = "$generation" ] &&
		printf '%s\n' "$at_candidates" | awk -v port="$cached_at" '$2==port { found=1 } END { exit !found }'; then
		at=$cached_at
		same_generation || { at=; return 1; }
		if [ "$auto_generation:$auto_at" != "$generation:$at" ]; then
			log "AT probe selected port=$at reason=cached-confirmed-port"
		fi
		auto_at=$at auto_generation=$generation
		return 0
	fi
	[ "$(now)" -ge "$next_try" ] || return 1
	count=$(printf '%s\n' "$at_candidates" | awk 'NF==2 { n++ } END { print n+0 }')
	if [ "$count" -eq 0 ] || [ "$count" -gt 8 ]; then
		at_failure=no-serial-candidates
		[ "$count" -le 8 ] || at_failure=too-many-serial-candidates
	else
		set_stage at-discovery 'probing same-parent serial ports with AT only'
		transaction_active=1
		transaction_mode=probe
		attempt_event=$(interface_event)
		transaction_end=$(( $(now) + transaction_timeout ))
		rc=1
		while read -r ifnum candidate; do
			[ -n "$candidate" ] || continue
			at=$candidate
			log "AT probe trying port=$at interface=$ifnum order=USB-interface-number"
			if configure_serial && query AT; then
				rc=0
				break
			fi
			log "AT probe failed port=$at reason=$at_failure"
			[ "$interrupted" = 0 ] && transaction_valid &&
				[ "$(now)" -lt "$transaction_end" ] || break
		done <<EOF
$at_candidates
EOF
		transaction_active=0
		if [ "$rc" = 0 ]; then
			auto_at=$at auto_generation=$generation
			# Private runtime cache survives monitor restarts, not USB generations.
			printf '%s\n%s\n' "$generation" "$at" >"$cache.$$" &&
				mv -f "$cache.$$" "$cache" ||
				log 'AT probe cache write failed; retaining in-memory selection'
			log "AT probe selected port=$at interface=$ifnum reason=first-confirmed-AT-response"
			backoff=$retry_initial
			next_try=0
			return 0
		fi
	fi
	at=
	retry
	stage_failure at-discovery "automatic AT probe failed ($at_failure); retry scheduled at $next_try"
	return 1
}

begin_transaction() {
	transaction_end=$(( $(now) + transaction_timeout ))
	if [ "$transaction_mode" = health ]; then
		set_stage health-check 'performing scheduled modem health check' quiet
	else
		set_stage serial-at 'checking selected serial port and AT responsiveness'
	fi
	configure_serial || return 1
	query AT
}

function_ready() {
	local state
	query 'AT+CFUN?' || return 1
	state=$(awk '
		/\+CFUN:/ {
			line=substr($0,index($0,"+CFUN:")+6)
			gsub(/\r/,"",line); gsub(/ /,"",line)
			if (line=="0" || line=="1") print line
		}
	' "$RUN/response")
	case "$state" in
		1) return 0;;
		0) query 'AT+CFUN=1';;
		*) at_failure=unrecognized-radio-state; return 1;;
	esac
}

preinit() {
	query ATE0 || :
	query 'AT+CPIN?' || return 1
	awk '
		/\+CPIN:/ {
			line=substr($0,index($0,"+CPIN:")+6)
			gsub(/\r/,"",line); gsub(/[ \t]/,"",line)
			if (line=="READY") ready=1
			else not_ready=1
		}
		END { exit (!ready || not_ready) }
	' "$RUN/response" || {
		[ "$at_failure" != none ] || at_failure=SIM-not-ready-or-unrecognized-response
		return 1
	}
	# Keep diagnostics private, just like other AT responses.
	query 'AT+CSQ' || :
	[ "$interrupted" = 0 ] && same_generation
}

attached() {
	query 'AT+CGATT?' || return 2
	awk '
		/\+CGATT:/ {
			line=substr($0,index($0,"+CGATT:")+7)
			gsub(/\r/,"",line); gsub(/[ \t]/,"",line)
			if (line=="0" || line=="1") {
				if (known && state!=line) malformed=1
				known=1; state=line
			}
			else malformed=1
		}
		END { exit (malformed || !known ? 2 : (state=="1" ? 0 : 1)) }
	' "$RUN/response"
}

health() {
	local cg zg cg_failure zg_failure
	begin_transaction && registered || return 1
	active CGACT; cg=$?
	cg_failure=$at_failure
	active ZGACT; zg=$?
	zg_failure=$at_failure
	if [ "$cg_failure" != none ] && [ "$zg_failure" = none ]; then
		at_failure=$cg_failure
	fi
	[ "$interrupted" = 0 ] && same_generation || return 1
	[ "$cg" != 1 ] && [ "$zg" != 1 ] &&
		{ [ "$cg" = 0 ] || [ "$zg" = 0 ]; }
}

activate() {
	local cg zg attach cg_failure zg_failure
	activation_stage=serial-AT
	begin_transaction || return 1
	activation_stage=radio
	set_stage radio-state 'checking modem radio state'
	function_ready || { [ "$at_failure" != none ] || at_failure=unrecognized-radio-state; return 1; }
	activation_stage=SIM
	set_stage SIM 'checking SIM readiness'
	preinit || { [ "$at_failure" != none ] || at_failure=SIM-not-ready-or-unrecognized-response; return 1; }
	activation_stage=registration
	set_stage registration 'checking network registration'
	registered || return 1
	activation_stage=attachment
	set_stage attachment 'checking packet attachment'
	attached; attach=$?
	case "$attach" in 0|1) :;; *) [ "$at_failure" != none ] || at_failure=unrecognized-attachment-response; return 1;; esac
	activation_stage=PDP-validation
	set_stage PDP-validation 'validating PDP context without exposing APN'
	active CGACT; cg=$?
	cg_failure=$at_failure
	active ZGACT; zg=$?
	zg_failure=$at_failure
	if [ "$cg_failure" != none ] && [ "$zg_failure" = none ]; then
		at_failure=$cg_failure
	fi
	[ "$interrupted" = 0 ] && transaction_valid || return 1
	# A successfully omitted CID may be new, but only definitions can confirm that.
	if [ "$cg" = 3 ] && [ "$zg" != 0 ]; then
		undefined_context || return 1
		cg=1
	fi
	# Unknown CGACT state is not safe to overwrite; retry without changing the APN.
	[ "$cg" != 2 ] || [ "$zg" = 0 ] || {
		[ "$at_failure" != none ] || at_failure=unrecognized-PDP-state
		return 1
	}
	if [ "$cg" != 0 ] && [ "$zg" != 0 ]; then
		query "AT+CGDCONT=$cid,\"$pdp_type\",\"$apn\"" || return 1
	fi
	if [ "$attach" = 1 ]; then
		query 'AT+CGATT=1' || return 1
	fi
	if [ "$cg" != 0 ] && [ "$zg" != 0 ]; then
		query "AT+CGACT=1,$cid" || return 1
	fi
	activation_stage=ZTE-activation
	set_stage ZTE-activation 'sending required per-connection ZTE activation'
	# MF832S requires this command for each connection, even with stale active state.
	query "AT+ZGACT=1,$cid" || return 1
	# Success here means modem activation, not a DHCP lease.
	return 0
}

retry() {
	next_try=$(( $(now) + backoff ))
	backoff=$((backoff * 2))
	[ "$backoff" -le "$retry_max" ] || backoff=$retry_max
	write_state
}

record_failure() {
	[ "$interrupted" = 0 ] && same_generation || return
	[ "$recover_bad" -ge "$recover_threshold" ] || recover_bad=$((recover_bad + 1))
}

recovery_ready() {
	[ "$interrupted" = 0 ] && same_generation &&
	network_config "$net" && network_status "$net" &&
	[ "$up" = false ] && [ "$pending" = false ]
}

recover() {
	local rc
	[ "$recover_mode" = cfun_cycle ] &&
	[ "$recover_bad" -ge "$recover_threshold" ] &&
	[ "$(now)" -ge "$recover_next" ] && event_barrier && recovery_ready || return
	# Rate-limit attempts too, including failed or interrupted cycles.
	recover_next=$(( $(now) + recover_cooldown ))
	recover_bad=0
	transaction_active=1
	transaction_mode=recover
	attempt_event=$(interface_event)
	rc=1
	if begin_transaction && recovery_ready && query 'AT+CFUN=0'; then
		(
			exec 9>&- 7>&-
			exec sleep 2
		) &
		child=$!
		if await_child "$transaction_end" && query 'AT+CFUN=1'; then
			rc=0
		fi
	fi
	transaction_active=0
	[ "$rc" != 0 ] || log 'Modem radio recovery completed; retrying after backoff'
}

reconcile() {
	local previous current activation_rc recover_owned lease_changed previous_health
	set_stage event-listener 'verifying ubus event listener' quiet
	ensure_events || {
		stage_failure event-listener 'listener startup or readiness barrier failed; refusing connection changes'
		retry
		return
	}
	previous=$generation
	set_stage usb-discovery 'searching configured VID/PID and USB topology' quiet
	if ! discover; then
		stage_failure usb-discovery "$discovery_reason; waiting for an unambiguous ready device"
		network_down
		generation=
		return
	fi
	generation=$found_generation
	if [ "$generation" != "$previous" ]; then
		network_down || { retry; return; }
		next_try=0
		backoff=$retry_initial
		health_next=0
		health_bad=0
		recover_bad=0
	fi
	set_stage DHCP-interface-validation 'checking the configured logical DHCP interface and USB binding' quiet
	network_config "$net" || {
		stage_failure DHCP-interface-validation "$validation_reason; configured target must be an existing DHCP section bound to $net"
		network_down
		return
	}
	network_status "$net" || {
		stage_failure DHCP-interface-validation "$validation_reason; refusing to alter target"
		network_down
		return
	}
	select_at || return
	if [ "$generation" != "$previous" ]; then
		set_stage usb-associated "confirmed AT port and USB data device; at=$at net=$net"
	else
		set_stage usb-associated "confirmed AT port and USB data device; at=$at net=$net" quiet
	fi
	diagnostic=
	lease_changed=0
	if [ "$has_ipv4" != "$observed_ipv4" ]; then
		lease_changed=1
		observed_ipv4=$has_ipv4
		if [ "$has_ipv4" != true ]; then
			log 'netifd IPv4 lease is no longer present; connection is not online'
		fi
	fi
	current=$(now)
	if [ "$current" -lt "$next_try" ]; then
		set_stage backoff "retry scheduled after bounded backoff at $next_try" quiet
		write_state
		return
	fi
	# A down edge invalidates ownership even if a rapid restart is already up.
	if [ -n "$owned_device" ] && {
		[ "$(interface_event)" != "$owned_event" ] ||
		{ [ "$owned_online" = 1 ] && [ "$up" = false ]; }
	}; then
		network_down || { retry; return; }
		event_barrier || {
			stage_failure event-listener 'event barrier failed after interface teardown; refusing activation'
			retry
			return
		}
		retry
		set_stage retry 'target connection ended; next attempt requires AT activation'
		return
	fi
	if [ "$up" = true ]; then
		if [ "$has_ipv4" != true ]; then
			state_health=waiting-for-ipv4
			if [ "$lease_deadline" -eq 0 ]; then
				lease_deadline=$(( current + dhcp_timeout ))
				write_state
			fi
			set_stage DHCP-lease-waiting 'netifd reports up but no IPv4 lease; waiting within DHCP timeout'
			if [ "$current" -ge "$lease_deadline" ]; then
				if [ -n "$owned_device" ]; then
					network_down || { retry; return; }
					stage_failure DHCP-timeout 'no IPv4 lease before the configured DHCP deadline; backing off'
				else
					stage_failure DHCP-timeout 'unowned interface is up without IPv4; refusing takeover or teardown'
					lease_deadline=0
				fi
				retry
			fi
			write_state
			return
		fi
		lease_deadline=0
		has_ipv4=true
		[ "$lease_changed" = 1 ] && log 'netifd IPv4 lease acquired; public reachability is not implied'
		previous_health=$state_health
		state_health=checking
		[ -z "$owned_device" ] || owned_online=1
		set_stage online 'IPv4 lease present; this does not imply public Internet reachability' quiet
		write_state
		[ "$current" -ge "$health_next" ] || return
		transaction_active=1
		transaction_mode=health
		attempt_event=$(interface_event)
		health
		activation_rc=$?
		transaction_active=0
		health_next=$(( $(now) + health_interval ))
		if [ "$activation_rc" = 0 ]; then
			diagnostic=
			health_bad=0
			recover_bad=0
			state_health=healthy
			backoff=$retry_initial
			set_stage online 'IPv4 lease present; latest modem health check succeeded' quiet
			case "$previous_health" in degraded:*|waiting-for-ipv4)
				log 'AT health check recovered; IPv4 lease remains present'
				;;
			esac
		else
			record_failure
			health_bad=$((health_bad + 1))
			state_health="degraded:$at_failure"
			stage_failure health-failure "AT health check failed ($at_failure); failure $health_bad/$health_failures"
			if [ "$health_bad" -ge "$health_failures" ]; then
				# An interface that we did not start must never be cycled.
				recover_owned=0
				if [ "$owned_device" = "$net" ] &&
					[ "$owned_usb" = "$usb" ] &&
					[ "$owned_generation" = "$generation" ]; then
					recover_owned=1
				fi
				if network_down && [ "$recover_owned" = 1 ]; then
					recover
				fi
				retry
				health_bad=0
				stage_failure recovery 'repeated health failures; owned interface recovery is rate-limited'
			fi
		fi
		write_state
		return
	fi
	has_ipv4=false
	write_state
	if [ "$pending" = true ]; then
		if [ "$owned_device" = "$net" ] && [ "$owned_usb" = "$usb" ] &&
			[ "$owned_generation" = "$generation" ] && same_generation; then
			[ "$current" -ge "$lease_deadline" ] || return
			network_down || { retry; return; }
			retry
			stage_failure DHCP-timeout 'DHCP completed without an IPv4 lease before deadline; backing off'
			return
		fi
		# enabled=1 delegates only this validated target's pending DHCP to us.
		same_generation && network_config "$net" && network_status "$net" &&
			[ "$up" = false ] && [ "$pending" = true ] || return
		set_stage pending-coordination 'coordinating existing target DHCP pending before fresh AT activation'
		coordinate_pending || {
			stage_failure pending-coordination 'netifd pending teardown failed or state changed; refusing AT activation'
			retry
			return
		}
		# Drain our own synchronous netifd down event before opening a new attempt.
		event_barrier || {
			stage_failure event-listener 'event barrier failed after pending teardown; refusing AT activation'
			retry
			return
		}
		same_generation && network_config "$net" && network_status "$net" &&
			[ "$up" = false ] && [ "$pending" = false ] || {
			stage_failure pending-coordination 'pending DHCP state did not clear; refusing AT activation'
			retry
			return
		}
	fi
	[ "$available" = true ] || {
		stage_failure DHCP-interface-validation 'target netifd device is not available yet; waiting for device readiness'
		return
	}
	if [ -n "$owned_device" ] && [ "$lease_deadline" -gt "$current" ]; then
		set_stage DHCP-lease-waiting 'waiting for target IPv4 lease within configured timeout' quiet
		return
	fi
	if [ -n "$owned_device" ]; then
		network_down
		retry
		stage_failure DHCP-timeout 'DHCP did not produce an IPv4 lease; backing off'
		return
	fi
	event_barrier || {
		stage_failure event-listener 'event barrier failed before activation; refusing connection changes'
		retry
		return
	}
	set_stage serial-at 'starting the serialized AT activation transaction'
	transaction_active=1
	transaction_mode=activate
	attempt_event=$(interface_event)
	activate
	activation_rc=$?
	transaction_active=0
	if [ "$activation_rc" != 0 ]; then
		record_failure
		recover
		retry
		if [ "$interrupted" != 1 ]; then
			stage_failure AT-failure "activation failed at ${activation_stage:-serial-AT} ($at_failure); retry scheduled at $next_try"
		fi
		return
	fi
	recover_bad=0
	set_stage DHCP-start 'AT activation completed; verifying event fence before netifd DHCP'
	event_barrier && transaction_valid || {
		stage_failure event-listener 'event barrier or state validation failed after AT activation; DHCP not started'
		retry
		return
	}
	[ "$available" = true ] && [ "$pending" != true ] && [ "$up" != true ] || {
		stage_failure DHCP-start 'target changed after AT activation; waiting safely before DHCP start'
		return
	}
	if ubus -t 2 call "network.interface.$interface" up >/dev/null 2>&1; then
		owned_device=$net
		owned_usb=$usb
		owned_generation=$generation
		owned_event=$attempt_event
		owned_online=0
		lease_deadline=$(( $(now) + dhcp_timeout ))
		health_next=$(( $(now) + health_interval ))
		health_bad=0
		diagnostic=
		state_health=waiting-for-ipv4
		has_ipv4=false
		lease_deadline=$(( $(now) + dhcp_timeout ))
		set_stage DHCP-lease-waiting "AT activation completed; netifd DHCP started, waiting up to ${dhcp_timeout}s for IPv4"
	else
		retry
		stage_failure DHCP-start-failure 'netifd rejected target DHCP start; backing off'
	fi
}

log 'Starting MF832S monitor build=1.0.0-r3'
if ! mkdir -p "$RUN"; then
	log 'Startup failed: cannot create runtime directory /var/run/mf832s'
	exit 1
fi
chmod 700 "$RUN" 2>/dev/null || {
	log 'Startup failed: cannot secure runtime directory /var/run/mf832s'
	exit 1
}
if ! load_config; then
	log "Startup failed: invalid or disabled configuration ($config_error)"
	state_service=failed
	monitor_pid=
	set_stage startup-failure "invalid or disabled configuration ($config_error)"
	write_state
	exit 1
fi
if [ -n "$at_interface$at_device" ]; then
	log "Configuration accepted: target interface=$interface; explicit AT selection takes priority"
else
	log "Configuration accepted: target interface=$interface; automatic AT detection enabled"
fi
if [ "$interface" != mf832s ]; then
	log "Configured target differs from default mf832s interface; managing configured target $interface"
fi
for tool in chat stty ubus jsonfilter flock mkfifo mktemp; do
	command -v "$tool" >/dev/null 2>&1 || {
		log "Startup failed: required tool missing ($tool)"
		state_service=failed
		monitor_pid=
		set_stage startup-failure "required dependency missing: $tool"
		write_state
		exit 1
	}
done
# The kernel releases this persistent inode's lock even on a monitor crash.
exec 9>"$LOCK" || {
	log 'Startup failed: cannot open single-instance lock'
	exit 1
}
flock -n 9 || {
	log 'Startup refused: another MF832S monitor holds the instance lock'
	exit 1
}
# An orphan from a crashed instance must never write into a replacement's state.
RUN=$(mktemp -d "$RUN/instance.XXXXXX") || {
	log 'Startup failed: cannot create private instance runtime directory'
	state_service=failed
	monitor_pid=
	set_stage startup-failure 'private runtime directory creation failed'
	write_state
	exit 1
}
printf '%s\n' "$$" >"$RUN/pid"
monitor_pid=$$
state_service=running
stage_started=$(now)
stage_updated=$stage_started
stage_reason='monitor initialized; discovering modem'
write_state
trap 'cleanup; exit 0' TERM INT
trap wake USR1
while :; do
	interrupted=0
	reconcile
	# Events cancel work but do not reset backoff; polling catches missed events.
	(
		exec 9>&- 7>&-
		exec sleep "$poll_interval"
	) &
	child=$!
	wait "$child" 2>/dev/null
	child=
done
