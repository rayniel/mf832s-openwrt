config mf832s 'main'
	option enabled '0'
	option interface 'mf832s'
	option apn ''
	option pdp_type 'IPV4V6'
	option cid '1'
	option vid '19d2'
	option pid '0199'
	# Select a USB topology name (e.g. 1-1.2) or serial if multiple modems match.
	option usb_path ''
	option serial ''
	# Explicit AT USB interface number (two hex digits), or a /dev/ttyUSBn override.
	option at_interface ''
	option at_device ''
	# Optional network device override; it must belong to the selected USB modem.
	option net_device ''
	option query_timeout '5'
	option transaction_timeout '45'
	option poll_interval '10'
	option retry_initial '5'
	option retry_max '120'
	option dhcp_timeout '60'
	option health_interval '30'
	option health_failures '3'
