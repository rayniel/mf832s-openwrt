config mf832s 'main'
	option enabled '1'
	option interface 'mf832s'
	option apn ''
	option pdp_type 'IPV4V6'
	option cid '1'
	option vid '19d2'
	option pid '0199'
	# Select a USB topology name (e.g. 1-1.2) or serial if multiple modems match.
	option usb_path ''
	option serial ''
	# Optional explicit AT interface (two hex digits) or /dev/ttyUSBn override.
	# Leave both empty for bounded, same-USB-parent AT-only detection.
	option at_interface ''
	option at_device ''
	# Optional network device override; it must belong to the selected USB modem.
	option net_device ''
	option query_timeout '5'
	option transaction_timeout '45'
	option poll_interval '10'
	option retry_initial '5'
	option retry_max '120'
	option dhcp_timeout '60'
	option health_interval '30'
	option health_failures '3'
	# Optional radio recovery after repeated health or activation failures.
	# Modes: none, cfun_cycle (AT+CFUN=0 followed by AT+CFUN=1).
	option recover_mode 'cfun_cycle'
	option recover_threshold '3'
	# Minimum seconds between recovery attempts, including unsuccessful ones.
	option recover_cooldown '120'
