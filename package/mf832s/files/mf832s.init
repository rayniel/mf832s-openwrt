#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1
EXTRA_COMMANDS="network_changed"
EXTRA_HELP="	network_changed Wake monitor after network configuration changes"

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/mf832s-monitor
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 10
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger mf832s
	procd_add_config_trigger "config.change" "network" /etc/init.d/mf832s network_changed
}

network_changed() {
	local signal
	signal=$(kill -l USR1)
	ubus -t 1 call service signal "{\"name\":\"mf832s\",\"signal\":$signal}" >/dev/null 2>&1
}
